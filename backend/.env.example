AWS_REGION=ap-southeast-1
DATA_BUCKET=cs5224-lab2-data-<your-suffix>
EMR_APP_ID=<emr-serverless-application-id>
EMR_ROLE_ARN=arn:aws:iam::<account-id>:role/cs5224-lab2-emr-runtime
INPUT_KEY=input/twitter_combined.txt
SCRIPT_KEY=scripts/follow_counts.py
OUTPUT_PREFIX=output/
# Optional: uploaded to INPUT_KEY by POST /api/jobs if it is missing in S3
LOCAL_DATASET=
# Comma-separated; set to the S3 website origin once the frontend is deployed
ALLOWED_ORIGINS=*
