{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DataBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::__DATA_BUCKET__"
    },
    {
      "Sid": "DataObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::__DATA_BUCKET__/*"
    },
    {
      "Sid": "RunSparkJobs",
      "Effect": "Allow",
      "Action": ["emr-serverless:StartJobRun", "emr-serverless:GetJobRun"],
      "Resource": [
        "arn:aws:emr-serverless:__REGION__:__ACCOUNT_ID__:/applications/__EMR_APP_ID__",
        "arn:aws:emr-serverless:__REGION__:__ACCOUNT_ID__:/applications/__EMR_APP_ID__/jobruns/*"
      ]
    },
    {
      "Sid": "PassRuntimeRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::__ACCOUNT_ID__:role/cs5224-lab2-emr-runtime",
      "Condition": { "StringEquals": { "iam:PassedToService": "emr-serverless.amazonaws.com" } }
    }
  ]
}
